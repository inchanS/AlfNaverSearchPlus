#!/bin/bash
# Emit typed Alfred UI properties before the IME preload. Only the numeric
# settings and font names selected below are interpolated in the JSON.
case "$nn_rows" in
    8|10) rows=$nn_rows ;;
    *) rows=6 ;;
esac

case "$nn_font" in
    large)      font=large;      query=extralarge; secondary=default; service=default;    row=51; chrome=191 ;;
    extra_large) font=extralarge; query=ginormous;  secondary=large;   service=medium;     row=59; chrome=207 ;;
    *)          font=default;    query=large;      secondary=small;   service=small;      row=43; chrome=177 ;;
esac

case "$nn_width" in
    theme) width='' ;;
    wide)  width='"width":760,' ;;
    *)     width='"width":595,' ;;
esac

# An empty field has no request to match. Typing starts a fresh lookup via prepare.
lookup=idle
if [[ -n $1 ]]; then
    request_id=$(/usr/bin/uuidgen) || exit 1
    lookup=lookup_$request_id
fi
height=$((rows * row))
tab_style="{\"font\":{\"size\":\"$secondary\"}}"
exec /bin/cat <<JSON
{
  "variables": {
    "lookup": "$lookup",
    "nn_list_height": $height, "nn_row_height": $row,
    "nn_primary_font": "$font", "nn_secondary_font": "$secondary"
  },
  "window": {"resize": {$width "height": $((height + chrome))}},
  "replace": {"ids": {"results_area": "{file:results-area.json}"}},
  "update": {
    "relayout": true,
    "ids": {
      "query": {"font": {"size": "$query"}}, "map_location": {"font": {"size": "$secondary"}},
      "service_name": {"font": {"size": "$service"}},
      "tab_search": {"font": {"size": "$secondary", "weight": "semibold"}}, "tab_map": $tab_style, "tab_finance": $tab_style, "tab_shopping": $tab_style,
      "hint": {"font": {"size": "$secondary"}, "text": "↑↓ 선택    ↩ 열기    ⌘L 검색창"}
    }
  }
}
JSON
