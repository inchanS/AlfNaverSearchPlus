{
  "bundleid": "com.inchans.alfnaversearchplus.nui",
  "variablesconfig": {
    "nn_map_location": {"src": "variable", "default": "useIP", "scriptenv": true},
    "latitude": {"src": "variable", "scriptenv": true},
    "longitude": {"src": "variable", "scriptenv": true},
    "cache_age": {"src": "variable", "scriptenv": true},
    "alfred_workflow_cache": {"src": "variable", "scriptenv": true},
    "alfred_workflow_data": {"src": "variable", "scriptenv": true},
    "nnime_compatibility": {"src": "variable", "default": "0", "scriptenv": true},
    "nnime_previous": {"default": "", "scriptenv": true},
    "nnime_applied": {"default": "", "scriptenv": true},
    "nn_resume": {"src": "variable", "default": "0", "scriptenv": true},
    "source_query": {"src": "args[0]", "default": ""},
    "initial_query": {"src": "args[0]", "default": ""}
  },
  "colours": {"tabFill": "#80808020", "activeTabFill": "#47AA614A"},
  "variables": {
    "category": "search", "lookup": "idle",
    "nn_list_height": 258, "nn_row_height": 43,
    "nn_primary_font": "default", "nn_secondary_font": "small",
    "nn_query_font": "large", "nn_service_font": "small"
  },
  "window": {
    "title": "네이버 통합검색",
    "padding": 6,
    "size": {"width": 595, "height": 435},
    "root": {
      "type": "view",
      "layout": "inline",
      "direction": "vertical",
      "spacing": 8,
      "events": [
        {
          "triggers": "preload",
          "action": {"type": "script", "src": "./run", "args": ["_ime", "enter"]}
        },
        {"triggers": "launched", "action": [{"type": "script", "src": "./run", "args": ["nui", "start", "{var:initial_query}"]}, "{file:fetch.json}"]},
        {"triggers": "quit", "action": ["{file:remember.json}", "{file:leave-input.json}"]}
      ],
      "shortcuts": [
        {"shortcut": "↑", "action": [{"type": "function", "src": "results", "args": "selectup"}, "{file:preview.json}"]},
        {"shortcut": "↓", "action": [{"type": "function", "src": "results", "args": "selectdown"}, "{file:preview.json}"]},
        {"shortcut": "⇧↩", "action": {"type": "script", "src": "./run", "args": ["nui", "open", "{value:results.selected.shiftURL}", "{value:results.selected.lookup}", "{var:lookup}", "{var:category}", "{var:source_query}", "{value:results.selected.url}"]}},
        {
          "shortcut": "⌘L",
          "action": {"type": "json", "src": {"update": {"ids": {"query": {"focus": true}}}}}
        },
        {
          "shortcut": "⌘\uf701",
          "action": {"type": "json", "src": {"update": {"ids": {"results_area": {"focus": true}}}}}
        },
        {"shortcut": "\u001b", "action": ["{file:leave-input.json}", {"type": "json", "src": {"finish": {}}}]}
      ],
      "components": [
        {
          "type": "view",
          "layout": "border",
          "spacing": 8,
          "components": [
            {
              "id": "query",
              "type": "textfield",
              "font": {"size": "{var:nn_query_font}"},
              "constraints": {"region": "centre"},
              "focus": true,
              "editable": true,
              "placeholder": "검색어",
              "text": "{var:initial_query}",
              "accessibility": {"label": "검색어"},
              "events": [
                {
                  "triggers": "changed",
                  "action": [
                    {"type": "script", "src": "./run", "args": ["nui", "prepare", "{var:category}", "{value:query.text}", "{var:category}"]},
                    "{file:fetch.json}"
                  ]
                },
                {
                  "triggers": "actioned",
                  "action": "{file:open.json}"
                }
              ]
            },
            {
              "id": "service_name",
              "type": "label",
              "font": {"size": "{var:nn_service_font}"},
              "text": "네이버 통합검색",
              "colour": "secondaryLabelColor",
              "textalign": "right",
              "constraints": {"region": "top"}
            }
          ]
        },
        {
          "type": "view",
          "layout": "border",
          "spacing": 4,
          "components": [
            {"type": "view", "layout": "inline", "direction": "horizontal", "spacing": 6, "constraints": {"region": "left"}, "components": [
              {
                "type": "view", "id": "segment_search", "background": "activeTabFill", "cornerradius": 6, "padding": 2,
                "components": [
                  {
                    "type": "button",
                    "bordered": false,
                    "id": "tab_search",
                    "font": {"size": "{var:nn_secondary_font}", "weight": "semibold"},
                    "text": "일반 ⌘1",
                    "shortcut": "⌘1",
                    "events": {
                      "triggers": "actioned",
                      "action": [
                        {
                          "type": "script",
                          "src": "./run",
                          "args": ["nui", "prepare", "search", "{value:query.text}", "{var:category}"]
                        },
                        "{file:fetch.json}"
                      ]
                    }
                  }
                ]
              },
              {
                "type": "view", "id": "segment_map", "background": "tabFill", "cornerradius": 6, "padding": 2,
                "components": [
                  {
                    "type": "button",
                    "bordered": false,
                    "id": "tab_map",
                    "font": {"size": "{var:nn_secondary_font}"},
                    "text": "지도 ⌘2",
                    "shortcut": "⌘2",
                    "events": {
                      "triggers": "actioned",
                      "action": [
                        {
                          "type": "script",
                          "src": "./run",
                          "args": ["nui", "prepare", "map", "{value:query.text}", "{var:category}"]
                        },
                        "{file:fetch.json}"
                      ]
                    }
                  }
                ]
              },
              {
                "type": "view", "id": "segment_finance", "background": "tabFill", "cornerradius": 6, "padding": 2,
                "components": [
                  {
                    "type": "button",
                    "bordered": false,
                    "id": "tab_finance",
                    "font": {"size": "{var:nn_secondary_font}"},
                    "text": "증권 ⌘3",
                    "shortcut": "⌘3",
                    "events": {
                      "triggers": "actioned",
                      "action": [
                        {
                          "type": "script",
                          "src": "./run",
                          "args": ["nui", "prepare", "finance", "{value:query.text}", "{var:category}"]
                        },
                        "{file:fetch.json}"
                      ]
                    }
                  }
                ]
              },
              {
                "type": "view", "id": "segment_shopping", "background": "tabFill", "cornerradius": 6, "padding": 2,
                "components": [
                  {
                    "type": "button",
                    "bordered": false,
                    "id": "tab_shopping",
                    "font": {"size": "{var:nn_secondary_font}"},
                    "text": "쇼핑 ⌘4",
                    "shortcut": "⌘4",
                    "events": {
                      "triggers": "actioned",
                      "action": [
                        {
                          "type": "script",
                          "src": "./run",
                          "args": ["nui", "prepare", "shopping", "{value:query.text}", "{var:category}"]
                        },
                        "{file:fetch.json}"
                      ]
                    }
                  }
                ]
              }
            ]},
            {"id": "map_location", "type": "label", "text": "", "textalign": "right", "colour": "secondaryLabelColor", "font": {"size": "{var:nn_secondary_font}"}, "constraints": {"region": "centre"}}
          ]
        },
        "{file:results-area.json}",
        {"id": "hint", "type": "label", "colour": "secondaryLabelColor", "font": {"size": "{var:nn_secondary_font}"}, "text": "↑↓ 선택    ↩ 열기    ⌘L 검색창"}
      ]
    }
  }
}
