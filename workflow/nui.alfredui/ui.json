{
  "bundleid": "com.inchans.alfnaversearchplus.nui",
  "variablesconfig": {
    "nn_width": {"src": "variable", "scriptenv": true},
    "nn_rows": {"src": "variable", "scriptenv": true},
    "nn_font": {"src": "variable", "scriptenv": true},
    "nn_map_location": {"src": "variable", "default": "useIP", "scriptenv": true},
    "latitude": {"src": "variable", "scriptenv": true},
    "longitude": {"src": "variable", "scriptenv": true},
    "cache_age": {"src": "variable", "scriptenv": true},
    "alfred_workflow_cache": {"src": "variable", "scriptenv": true},
    "alfred_workflow_data": {"src": "variable", "scriptenv": true},
    "nnime_previous": {"default": "", "scriptenv": true},
    "nnime_applied": {"default": "", "scriptenv": true},
    "initial_query": {"src": "args[0]", "default": ""}
  },
  "variables": {"category": "search"},
  "window": {
    "title": "네이버 통합검색",
    "padding": 14,
    "size": {"height": 455},
    "root": {
      "type": "view",
      "layout": "inline",
      "direction": "vertical",
      "spacing": 8,
      "events": [
        {
          "triggers": "preload",
          "action": [
            {"type": "script", "src": "./layout", "args": ["{var:initial_query}"]},
            {"type": "script", "src": "./run", "args": ["_ime", "enter"]}
          ]
        },
        {"triggers": "launched", "action": "{file:fetch.json}"},
        {"triggers": "quit", "action": "{file:leave-input.json}"}
      ],
      "shortcuts": [
        {"shortcut": "↑", "action": [{"type": "function", "src": "results", "args": "selectup"}, "{file:preview.json}"]},
        {"shortcut": "↓", "action": [{"type": "function", "src": "results", "args": "selectdown"}, "{file:preview.json}"]},
        {"shortcut": "⇧↩", "action": {"type": "script", "src": "./run", "args": ["nui", "open", "{value:results.selected.shiftURL}", "{value:results.selected.lookup}", "{var:lookup}"]}},
        {
          "shortcut": "⌘L",
          "action": {"type": "json", "src": {"update": {"ids": {"query": {"focus": true}}}}}
        },
        {
          "shortcut": "⌘\uf701",
          "action": {"type": "json", "src": {"update": {"ids": {"results_area": {"focus": true}}}}}
        },
        {"shortcut": "\u001b", "action": ["{file:leave-input.json}", {"type": "json", "src": {"finish": {}}}]}
      ],
      "components": [
        {
          "id": "query",
          "type": "textfield",
          "focus": true,
          "editable": true,
          "placeholder": "검색어",
          "text": "{var:initial_query}",
          "accessibility": {"label": "검색어"},
          "events": [
            {
              "triggers": "changed",
              "action": [
                {"type": "script", "src": "./run", "args": ["nui", "prepare", "{var:category}", "{value:query.text}", "{var:category}"]},
                "{file:fetch.json}"
              ]
            },
            {
              "triggers": "actioned",
              "action": "{file:open.json}"
            }
          ]
        },
        {
          "type": "view",
          "layout": "inline",
          "direction": "horizontal",
          "spacing": 6,
          "components": [
            {
              "type": "button",
              "id": "tab_search",
              "text": "일반 ⌘1",
              "shortcut": "⌘1",
              "events": {
                "triggers": "actioned",
                "action": [
                  {
                    "type": "script",
                    "src": "./run",
                    "args": ["nui", "prepare", "search", "{value:query.text}", "{var:category}"]
                  },
                  "{file:fetch.json}"
                ]
              }
            },
            {
              "type": "button",
              "id": "tab_map",
              "text": "지도 ⌘2",
              "shortcut": "⌘2",
              "events": {
                "triggers": "actioned",
                "action": [
                  {
                    "type": "script",
                    "src": "./run",
                    "args": ["nui", "prepare", "map", "{value:query.text}", "{var:category}"]
                  },
                  "{file:fetch.json}"
                ]
              }
            },
            {
              "type": "button",
              "id": "tab_finance",
              "text": "증권 ⌘3",
              "shortcut": "⌘3",
              "events": {
                "triggers": "actioned",
                "action": [
                  {
                    "type": "script",
                    "src": "./run",
                    "args": ["nui", "prepare", "finance", "{value:query.text}", "{var:category}"]
                  },
                  "{file:fetch.json}"
                ]
              }
            },
            {
              "type": "button",
              "id": "tab_shopping",
              "text": "쇼핑 ⌘4",
              "shortcut": "⌘4",
              "events": {
                "triggers": "actioned",
                "action": [
                  {
                    "type": "script",
                    "src": "./run",
                    "args": ["nui", "prepare", "shopping", "{value:query.text}", "{var:category}"]
                  },
                  "{file:fetch.json}"
                ]
              }
            }
          ]
        },
        {"id": "category_label", "type": "label", "text": "일반 검색"},
        {"type": "view", "id": "results_area"},
        {"id": "hint", "type": "label", "colour": "secondaryLabelColor", "font": {"size": "small"}}
      ]
    }
  }
}
