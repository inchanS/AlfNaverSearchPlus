{
  "bundleid": "com.inchans.alfnaversearchplus.nui",
  "variablesconfig": {
    "latitude": {"src": "variable", "scriptenv": true},
    "longitude": {"src": "variable", "scriptenv": true},
    "cache_age": {"src": "variable", "scriptenv": true},
    "alfred_workflow_cache": {"src": "variable", "scriptenv": true},
    "alfred_workflow_data": {"src": "variable", "scriptenv": true},
    "nnime_previous": {"default": "", "scriptenv": true},
    "nnime_applied": {"default": "", "scriptenv": true},
    "initial_query": {"src": "args[0]", "default": ""}
  },
  "variables": {"category": "search"},
  "window": {
    "title": "네이버 통합검색",
    "padding": 14,
    "size": {"width": 595, "height": 455},
    "root": {
      "type": "view",
      "layout": "inline",
      "direction": "vertical",
      "spacing": 8,
      "events": [
        {
          "triggers": "preload",
          "action": {"type": "script", "src": "./run", "args": ["_ime", "enter"]}
        },
        {
          "triggers": "launched",
          "action": [
            {"type": "script", "src": "./run", "args": ["nui", "prepare", "search", "{value:query.text}", "{var:category}"]},
            "{file:fetch.json}"
          ]
        },
        {"triggers": "quit", "action": "{file:leave-input.json}"}
      ],
      "shortcuts": [
        {
          "shortcut": "⌘L",
          "action": {"type": "json", "src": {"update": {"ids": {"query": {"focus": true}}}}}
        },
        {
          "shortcut": "⌘\uf701",
          "action": {"type": "json", "src": {"update": {"ids": {"results_area": {"focus": true}}}}}
        },
        {"shortcut": "\u001b", "action": ["{file:leave-input.json}", {"type": "json", "src": {"finish": {}}}]}
      ],
      "components": [
        {
          "id": "query",
          "type": "textfield",
          "focus": true,
          "editable": true,
          "placeholder": "검색어",
          "text": "{var:initial_query}",
          "accessibility": {"label": "검색어"},
          "events": [
            {
              "triggers": "changed",
              "action": [
                {"type": "script", "src": "./run", "args": ["nui", "prepare", "{var:category}", "{value:query.text}", "{var:category}"]},
                "{file:fetch.json}"
              ]
            },
            {
              "triggers": "actioned",
              "action": {"type": "json", "src": {"update": {"ids": {"results_area": {"focus": true}}}}}
            }
          ]
        },
        {
          "type": "view",
          "layout": "inline",
          "direction": "horizontal",
          "spacing": 6,
          "components": [
            {
              "type": "button",
              "text": "일반 ⌘1",
              "shortcut": "⌘1",
              "events": {
                "triggers": "actioned",
                "action": [
                  {
                    "type": "script",
                    "src": "./run",
                    "args": ["nui", "prepare", "search", "{value:query.text}", "{var:category}"]
                  },
                  "{file:fetch.json}"
                ]
              }
            },
            {
              "type": "button",
              "text": "지도 ⌘2",
              "shortcut": "⌘2",
              "events": {
                "triggers": "actioned",
                "action": [
                  {
                    "type": "script",
                    "src": "./run",
                    "args": ["nui", "prepare", "map", "{value:query.text}", "{var:category}"]
                  },
                  "{file:fetch.json}"
                ]
              }
            },
            {
              "type": "button",
              "text": "증권 ⌘3",
              "shortcut": "⌘3",
              "events": {
                "triggers": "actioned",
                "action": [
                  {
                    "type": "script",
                    "src": "./run",
                    "args": ["nui", "prepare", "finance", "{value:query.text}", "{var:category}"]
                  },
                  "{file:fetch.json}"
                ]
              }
            },
            {
              "type": "button",
              "text": "쇼핑 ⌘4",
              "shortcut": "⌘4",
              "events": {
                "triggers": "actioned",
                "action": [
                  {
                    "type": "script",
                    "src": "./run",
                    "args": ["nui", "prepare", "shopping", "{value:query.text}", "{var:category}"]
                  },
                  "{file:fetch.json}"
                ]
              }
            }
          ]
        },
        {"id": "category_label", "type": "label", "text": "일반 검색"},
        {
          "id": "results_area",
          "type": "view",
          "layout": "stack",
          "focusable": true,
          "accessibility": {"label": "검색 결과"},
          "constraints": {"size": {"height": 288}},
          "shortcuts": [
            {"shortcut": "\uf701", "action": {"type": "function", "src": "results", "args": "selectdown"}},
            {"shortcut": "\uf700", "action": {"type": "function", "src": "results", "args": "selectup"}},
            {
              "shortcut": "↩",
              "action": {"type": "script", "src": "./run", "args": ["nui", "open", "{value:results.selected.url}", "{value:results.selected.lookup}", "{var:lookup}"]}
            },
            {
              "shortcut": "⌥↩",
              "action": {"type": "script", "src": "./run", "args": ["nui", "open", "{value:results.selected.url}", "{value:results.selected.lookup}", "{var:lookup}"]}
            },
            {
              "shortcut": "⇧↩",
              "action": {
                "type": "script",
                "src": "./run",
                "args": ["nui", "open", "{value:results.selected.shiftURL}", "{value:results.selected.lookup}", "{var:lookup}"]
              }
            }
          ],
          "components": ["{file:results.json}", "{file:response-slot.json}"]
        },
        {"id": "hint", "type": "label", "colour": "secondaryLabelColor", "font": {"size": "small"}}
      ]
    }
  }
}
