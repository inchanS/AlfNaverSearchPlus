{
  "id": "results",
  "type": "dataview",
  "constraints": {"size": {"height": "{var:nn_list_height}"}},
  "placeholder": "",
  "cell": {
    "root": {
      "id": "row",
      "type": "view",
      "layout": "border",
      "cornerradius": 6,
      "padding": 5,
      "spacing": 8,
      "components": [
        {
          "type": "view", "layout": "inline", "direction": "vertical", "spacing": 1,
          "constraints": {"region": "centre"},
          "components": [
            {"id": "name", "type": "label", "font": {"size": "{var:nn_primary_font}", "weight": "semibold"}},
            {"id": "detail", "type": "label", "font": {"size": "{var:nn_secondary_font}"}}
          ]
        },
        {
          "id": "key_hint", "type": "label", "textalign": "right",
          "constraints": {"region": "right"},
          "font": {"size": "{var:nn_secondary_font}"}, "opacity": 0.8
        }
      ]
    },
    "height": "{var:nn_row_height}",
    "init": {"row.background": null, "name.colour": "labelColor", "detail.colour": "secondaryLabelColor", "key_hint.text": "", "key_hint.colour": "secondaryLabelColor"},
    "selected": {
      "row.background": "alfredSelectedResultBackgroundColor",
      "name.colour": "alfredSelectedResultTextColor",
      "detail.colour": "alfredSelectedResultTextColor",
      "key_hint.colour": "alfredSelectedResultTextColor"
    }
  },
  "data": {"type": "basic", "src": []},
  "events": {
    "triggers": "actioned",
    "action": "{file:open.json}"
  }
}
